{
  "name": "@restyleather/bend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "tsx src/index.ts --production",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "test:operations": "tsx --test tests/branch-operations.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.3.1",
    "hono": "^4.13.16",
    "pg": "8.20.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}

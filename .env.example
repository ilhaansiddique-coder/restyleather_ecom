DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/restyleather
APP_ORIGIN=http://localhost:3000
# Public canonical storefront URL used for search metadata and the sitemap.
# STOREFRONT_URL=https://store.example.com
BACKEND_PORT=3001
# Optional when the backend runs on a separate host.
# BACKEND_ORIGIN=http://127.0.0.1:3001
# Optional origin for Flutter web, such as https://app.example.com.
FLUTTER_WEB_ORIGIN=
# Set these when bootstrapping the first admin, then remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
